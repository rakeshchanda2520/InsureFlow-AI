OPENAI_API_KEY=sk-...
INSUREFLOW_MODEL=gpt-4o-mini
INSUREFLOW_ENV=development

# Langfuse tracing and evaluation. Leave the keys blank to switch it off.
# Older Andromeda releases read LANGFUSE_HOST instead of LANGFUSE_BASE_URL: set both if unsure.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
